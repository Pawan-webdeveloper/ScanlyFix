# Postgres. The one variable every part of the app needs.
DATABASE_URL= postgresql://test:test@localhost:5432/test

# Supabase project. NEXT_PUBLIC_ values are inlined into the browser bundle at
# build time, so they are public by definition. The publishable key is the
# rate-limited, RLS-bound key safe to ship to the browser — never the
# service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<value>

# Production app URL — required. Must match "Site URL" in
# Supabase Auth → URL Configuration, and `${NEXT_PUBLIC_APP_URL}/auth/callback`
# must be on the Supabase redirect allowlist, otherwise every OAuth sign-in
# fails with redirect_uri_not_in_whitelist. Use http://localhost:3000 for local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JSON array of redirect URIs this deployment will accept. Mirrors the
# Supabase dashboard's redirect allowlist; the proxy logs a one-line warning
# when the two diverge. The Supabase client refuses to redirect to anything
# not in its own allowlist — this is a deploy-time sanity check, not a
# security boundary.
SUPABASE_REDIRECT_ALLOWLIST=["https://example.com/auth/callback","http://localhost:3000/auth/callback"]

# Salt for hashing visitor addresses before they reach the database.
# 32+ bytes of random hex. Without one, an IPv4 hash is trivially reversed.
IP_HASH_SALT= test-salt-for-testing-only-32bytes-minimum

# Inngest event + signing keys, from inngest.com → your app → keys.
INNGEST_EVENT_KEY=signkey-dev-<...>
INNGEST_SIGNING_KEY=signkey-prod-<...>

# Razorpay. Absent until billing is configured.
RAZORPAY_KEY_ID=rzp_test_<...>
RAZORPAY_KEY_SECRET=<...>
RAZORPAY_PLAN_PRO_MONTHLY=plan_<...>
RAZORPAY_WEBHOOK_SECRET=#whsec_<...>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_<...>

# PageSpeed Insights API key, for the CWV check. Optional.
PAGESPEED_API_KEY=<...>

# Browser-tier scanner, for Phase 6/8.
DARVIN_SCANNER_URL=http://127.0.0.1:8080
DARVIN_SCANNER_TOKEN=<...>

# Fix prompts (AI fix generation, lib/fixes.ts). Only the key is required;
# without it the Fix buttons explain themselves. The key is server-only — it
# reaches OpenRouter from API routes and never the browser bundle. FIXES_MODEL
# overrides the model; it defaults to nvidia/nemotron-3-ultra-550b-a55b:free
# on OpenRouter.
#
# Set this ONLY here. Do not `export` it in ~/.zshrc: Next.js loads .env
# without overriding variables already in the shell, so a stale exported key
# (e.g. one you later revoked on openrouter.ai) silently beats the .env value
# and every Fix press 502s with a 401 nothing else can see.
OPENROUTER_API_KEY=<...>
FIXES_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Convex. Optional — only used for realtime features.
CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=

# OAuth provider secrets for Supabase built-in providers.
AUTH_GITHUB_SECRET=<...>
AUTH_GOOGLE_SECRET=GOCSPX-<...>

# The GitHub App behind Connect GitHub (repo scanning). GITHUB_APP_SLUG builds
# the install link; APP_ID + PRIVATE_KEY sign the JWT that mints installation
# tokens; WEBHOOK_SECRET verifies github.com's deliveries; SITE_URL is the
# public origin the app bounces back to after install.
#
# The post-install redirect goes back to the ORIGIN THE BUTTON WAS CLICKED ON
# (lib/github-connect.ts), because session cookies are per-origin. For the
# flow to complete on any deployment, that origin's callback must be listed on
# the GitHub App (github.com/settings/apps/<slug> → Callback URL, one per
# line, up to 10), e.g. for local testing:
#   http://localhost:3000/api/github/callback
GITHUB_APP_SLUG=<...>
GITHUB_APP_ID=<...>
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=<...>
NEXT_PUBLIC_SITE_URL=https://scanlyfix.com

# Resend, for transactional email. Optional.
AUTH_RESEND_KEY=re_<...>
